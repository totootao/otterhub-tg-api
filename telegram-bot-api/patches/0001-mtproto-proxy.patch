@@ -134,6 +134,136 @@ static void sigsegv_signal_handler(int signum, void *addr) {
   fail_signal_handler(signum);
 }
 
+// ============================================================
+// OtterHub: MTProto 出站代理支持
+// 格式: socks5://user:password@host:port
+//        http://user:password@host:port
+//        mtproto://secret@host:port
+// userinfo 支持 %XX 百分号编码。灵感来自 tangyoha/telegram_media_downloader
+// 的 proxy 配置（scheme/hostname/port/username/password），此处统一为 URL 形式。
+// ============================================================
+
+static int hex_digit_value(char c) {
+  if (c >= '0' && c <= '9') {
+    return c - '0';
+  }
+  if (c >= 'a' && c <= 'f') {
+    return c - 'a' + 10;
+  }
+  if (c >= 'A' && c <= 'F') {
+    return c - 'A' + 10;
+  }
+  return -1;
+}
+
+static td::string url_percent_decode(const td::string &s) {
+  td::string result;
+  result.reserve(s.size());
+  for (size_t i = 0; i < s.size(); i++) {
+    if (s[i] == '%' && i + 2 < s.size()) {
+      auto high = hex_digit_value(s[i + 1]);
+      auto low = hex_digit_value(s[i + 2]);
+      if (high >= 0 && low >= 0) {
+        result.push_back(static_cast<char>(high * 16 + low));
+        i += 2;
+        continue;
+      }
+    }
+    result.push_back(s[i]);
+  }
+  return result;
+}
+
+static td::Status parse_mtproto_proxy(td::Slice url, ClientParameters &parameters) {
+  td::Slice rest = url;
+  td::int32 type;
+  if (td::begins_with(rest, "socks5://")) {
+    type = ClientParameters::MtprotoProxySocks5;
+    rest.remove_prefix(9);
+  } else if (td::begins_with(rest, "socks://")) {
+    type = ClientParameters::MtprotoProxySocks5;
+    rest.remove_prefix(8);
+  } else if (td::begins_with(rest, "http://")) {
+    type = ClientParameters::MtprotoProxyHttp;
+    rest.remove_prefix(7);
+  } else if (td::begins_with(rest, "mtproto://")) {
+    type = ClientParameters::MtprotoProxyMtproto;
+    rest.remove_prefix(10);
+  } else {
+    return td::Status::Error(
+        "Unsupported proxy scheme: expected socks5://, http:// or mtproto:// in " + url.str());
+  }
+
+  auto hostport = rest.str();
+  auto at_pos = hostport.rfind('@');
+  td::string userinfo = at_pos == td::string::npos ? td::string() : hostport.substr(0, at_pos);
+  if (at_pos != td::string::npos) {
+    hostport = hostport.substr(at_pos + 1);
+  }
+
+  td::string host;
+  td::string port_str;
+  if (!hostport.empty() && hostport[0] == '[') {  // [IPv6]:port
+    auto close_pos = hostport.find(']');
+    if (close_pos == td::string::npos) {
+      return td::Status::Error("Invalid IPv6 proxy address in " + url.str());
+    }
+    host = hostport.substr(1, close_pos - 1);
+    if (close_pos + 1 < hostport.size()) {
+      if (hostport[close_pos + 1] != ':') {
+        return td::Status::Error("Expected ':' after IPv6 address in " + url.str());
+      }
+      port_str = hostport.substr(close_pos + 2);
+    }
+  } else {
+    auto colon_pos = hostport.rfind(':');
+    if (colon_pos == td::string::npos) {
+      return td::Status::Error("Proxy port is required in " + url.str());
+    }
+    host = hostport.substr(0, colon_pos);
+    port_str = hostport.substr(colon_pos + 1);
+  }
+  if (host.empty()) {
+    return td::Status::Error("Proxy host is empty in " + url.str());
+  }
+  if (port_str.empty()) {
+    return td::Status::Error("Proxy port is required in " + url.str());
+  }
+  TRY_RESULT(port, td::to_integer_safe<td::int32>(port_str));
+  if (port <= 0 || port > 65535) {
+    return td::Status::Error("Proxy port must be in range [1, 65535] in " + url.str());
+  }
+
+  td::string username;
+  td::string password;
+  td::string secret;
+  if (!userinfo.empty()) {
+    if (type == ClientParameters::MtprotoProxyMtproto) {
+      secret = url_percent_decode(userinfo);
+    } else {
+      auto colon_pos = userinfo.find(':');
+      if (colon_pos == td::string::npos) {
+        username = url_percent_decode(userinfo);
+      } else {
+        username = url_percent_decode(userinfo.substr(0, colon_pos));
+        password = url_percent_decode(userinfo.substr(colon_pos + 1));
+      }
+    }
+  }
+  if (type == ClientParameters::MtprotoProxyMtproto && secret.empty()) {
+    return td::Status::Error("MTProto proxy requires a secret: mtproto://secret@host:port");
+  }
+
+  parameters.use_mtproto_proxy_ = true;
+  parameters.mtproto_proxy_type_ = type;
+  parameters.mtproto_proxy_server_ = host;
+  parameters.mtproto_proxy_port_ = port;
+  parameters.mtproto_proxy_username_ = username;
+  parameters.mtproto_proxy_password_ = password;
+  parameters.mtproto_proxy_secret_ = secret;
+  return td::Status::OK();
+}
