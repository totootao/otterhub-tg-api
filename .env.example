# ============ OtterHub 自建 TG Bot API Server 配置 ============
# 复制为 .env 后填写（.env 已被 .gitignore 忽略，不会入库）

# --- Telegram API 凭证（必填）---
# https://my.telegram.org → API development tools 申请
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef

# --- 对外访问（必填）---
# 专用子域名：A 记录指向服务器公网 IP，务必 DNS only（灰云）
# 原因：Cloudflare 橙云代理对请求体有 100MB 上限，且灰云直连才能完成
# HTTP-01 证书自动签发
TG_DOMAIN=tg.example.com

# 访问令牌：防止端点被陌生人白嫖。生成：openssl rand -hex 16
# 需与 otterhub-server 端 TG_API_BASE 配置的 token 字段一致
PROXY_TOKEN=change-me

# --- 可选 ---
# 固定上游版本（tdlib/telegram-bot-api 的 40 位 commit SHA），默认 master
# 已验证快照：e3e9dd8e5b3d7ab8537cd5a10dc31d5ffa8f82d1 (2026-08-25)
#TBA_REF=e3e9dd8e5b3d7ab8537cd5a10dc31d5ffa8f82d1

# 服务器上源码构建时指定本地 tag（跳过 Docker Hub 拉取）
#TBA_IMAGE=otterhub-tg-api:local

# 透传给 telegram-bot-api 的额外启动参数
#TBA_EXTRA_ARGS=--verbosity=2
